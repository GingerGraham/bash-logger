<mxfile host="Electron" agent="bash-logger docs generator" version="24.7.17"><diagram name="T1. tests/run_tests.sh: discovery, dispatch, isolation and reporting" id="ce50a04acf6b584f8200"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1039" pageHeight="1437" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="T1. tests/run_tests.sh: discovery, dispatch, isolation and reporting" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-40" width="729.5" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Worker: run_test_suite FILE RESULT ( … ) — a subshell per suite" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#f4f8fd;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="226.0" y="463.0" width="449.0" height="364.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;./run_tests.sh [--junit] [--output-dir D] [-j N] [-x] [suite…]&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="242.2" y="0.0" width="477.5" height="36.0" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;main: parse options&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;PARALLEL_JOBS = -j | TEST_PARALLEL_JOBS | nproc (capped at 8)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;--fail-fast forces PARALLEL_JOBS=1&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="309.5" y="61.0" width="343.0" height="58.0" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Select suites&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;none named → find tests/test_*.sh (sorted), minus test_example / test_helpers&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;named → tests/&amp;lt;name&amp;gt;.sh&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="275.5" y="144.0" width="411.0" height="58.0" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;RESULTS_DIR = mktemp -d   (removed by an EXIT trap)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="298.5" y="227.0" width="365.0" height="29.0" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;PARALLEL_JOBS &amp;gt; 1?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="356.1" y="281.0" width="249.8" height="44.0" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Parallel: for each suite&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;wait_for_job_slot N&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;run_test_suite_with_progress … &amp;amp;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;(output → result_i.txt.output, status → .status)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="224.0" y="360.0" width="252.0" height="72.0" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;wait each PID in order&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;(status 127 → read result_i.txt.status)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;then aggregate every suite&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0.0" y="553.0" width="212.0" height="58.0" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Sequential: for each suite&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;run_test_suite … &amp;amp; ; wait&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;aggregate at once; -x stops after a failure&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="498.5" y="367.0" width="231.0" height="58.0" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;source test_helpers.sh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;counters = 0, setup_test_suite → TEST_TMP_DIR&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c4"><mxGeometry x="91.0" y="35.0" width="264.0" height="43.0" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;trap &amp;#x27;write_suite_results $?&amp;#x27; EXIT&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c4"><mxGeometry x="108.5" y="160.0" width="229.0" height="29.0" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;source tests/test_&amp;lt;suite&amp;gt;.sh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;the calls at the bottom of the file run each test&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#e0f2f1;strokeColor=#26a69a;" vertex="1" parent="c4"><mxGeometry x="95.0" y="214.0" width="256.0" height="43.0" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;write_suite_results (runs on any exit)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;cleanup_test_suite; print ✓/✗ line&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;write the result file&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c4"><mxGeometry x="94.0" y="292.0" width="258.0" height="58.0" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;result_i.txt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;SUITE_TESTS / PASSED / FAILED / SKIPPED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;SUITE_DURATION, SUITE_COMPLETED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;testcase XML lines, failed details&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;RESULTS_COMPLETE&lt;/font&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="333.5" y="848.0" width="231.0" height="86.0" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;aggregate_suite_result FILE RESULT STATUS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;no RESULTS_COMPLETE, not completed, non-zero exit or 0 tests&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;→ one synthetic failure + last 20 output lines&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="279.0" y="969.0" width="340.0" height="58.0" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;print_summary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Total / Passed / Failed / Skipped, failure details&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="322.0" y="1052.0" width="254.0" height="43.0" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;TEST_MAX_SKIPPED set and exceeded? → exit status 1&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="267.5" y="1120.0" width="363.0" height="29.0" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;--junit?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="390.2" y="1174.0" width="117.6" height="44.0" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;generate_junit_xml → test-reports/junit.xml&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;(SonarQube Generic Test Execution format)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="207.5" y="1253.0" width="293.0" height="43.0" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;junit.xml&lt;/b&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="312.5" y="1324.5" width="83.0" height="29.0" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;exit 0 = all passed&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="436.3" y="1321.0" width="179.4" height="36.0" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#555555;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;entry