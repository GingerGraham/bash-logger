"1" page="1" pageScale="1" pageWidth="1457" pageHeight="553" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="T3. Execution contexts: how a test reaches the code under test" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-40" width="1125.0" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Worker subshell (bash, from run_tests.sh)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#f3faf1;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="8.0" y="8.0" width="500.0" height="93.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Suite code&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;test_*.sh + test_helpers.sh&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#e0f2f1;strokeColor=#26a69a;" vertex="1" parent="c4"><mxGeometry x="14.0" y="35.5" width="161.0" height="43.0" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;In-process logging.sh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;sourced by setup_test before each test&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c4"><mxGeometry x="268.0" y="35.5" width="218.0" height="43.0" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;1. Direct calls&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;public API and internal functions&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;function stubs override internals&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="779.0" y="36.0" width="187.0" height="58.0" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;2. Child bash&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;bash -c &amp;quot;source logging.sh; …&amp;quot;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;run_with_logger&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;streams, exit codes, environment&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="553.0" y="185.0" width="193.0" height="72.0" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;3. Shell matrix&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;run_with_logger_in_shell / run_snippet_in_shell&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;for each entry of test_shell_list (TEST_SHELLS)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="256.0" y="255.0" width="258.0" height="58.0" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;4. Drivers (POSIX sh)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;compat/validator_driver.sh&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;compat/sanitize_driver.sh&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="305.5" y="415.0" width="159.0" height="58.0" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;5. Scenario scripts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;compat/scenarios/*.sh (18)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;run under each shell&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;