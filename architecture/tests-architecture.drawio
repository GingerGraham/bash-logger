="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="995" pageHeight="1132" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="T2. Life of one test function (test_helpers.sh contract)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="-40" width="685.5" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;test_something   (called explicitly at the bottom of the suite file)&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2.6" y="0.0" width="540.7" height="36.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;start_test &amp;quot;Display name&amp;quot;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;current_test, suite_tests++, TEST_START_TIME&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="144.5" y="61.0" width="257.0" height="43.0" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;setup_test&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;source logging.sh again → every setting back to its default&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;TEST_DIR = mktemp -d &amp;quot;$TEST_TMP_DIR/test.XXXXXX&amp;quot;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;TEST_STDOUT / TEST_STDERR paths&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="116.0" y="129.0" width="314.0" height="72.0" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Arrange&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;init_logger --quiet …, LOG_FILE=&amp;quot;$TEST_DIR/x.log&amp;quot;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;optional stub: _find_and_validate_logger() { return 0; }&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#e0f2f1;strokeColor=#26a69a;" vertex="1" parent="1"><mxGeometry x="125.0" y="226.0" width="296.0" height="58.0" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;needs another&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;shell?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="175.8" y="309.0" width="194.5" height="59.0" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;require_shell zsh || return 0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;(missing → skip_test, or fail_test if in TEST_REQUIRE_SHELLS)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0.0" y="403.0" width="330.0" height="43.0" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Act&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;log_* / set_* in-process, or bash -c / run_with_logger_in_shell&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;capture_output, capture_streams, run_with_timeout&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#e0f2f1;strokeColor=#26a69a;" vertex="1" parent="1"><mxGeometry x="210.0" y="481.0" width="326.0" height="58.0" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Assert&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;assert_equals, assert_contains, assert_matches&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;assert_file_contains / _not_contains / _empty …&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;assert_success / assert_failure      … || return&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="242.0" y="606.0" width="262.0" height="72.0" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;all assertions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;passed?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="279.9" y="703.0" width="186.2" height="59.0" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;pass_test&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;suite_passed++, print ✓&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="536.5" y="804.5" width="149.0" height="43.0" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;fail_test MSG   (called by the assert_* helper)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;suite_failed++, print ✗ + reason&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;FAILED_TEST_DETAILS += name: reason&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="203.0" y="797.0" width="308.0" height="58.0" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;skip_test REASON&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;suite_skipped++, print ⊘&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="89.0" y="551.0" width="152.0" height="43.0" as="geometry"/></mxCell><mxCel