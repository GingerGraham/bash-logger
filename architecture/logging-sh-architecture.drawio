-size: 10px;&quot;&gt;BASH_SOURCE[2] | funcfiletrace[2] | $0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;→ basename → _sanitize_script_name&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="408.0" y="61.0" width="219.0" height="58.0" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Pass 1: scan args for the first -c / --config&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="376.0" y="144.0" width="283.0" height="29.0" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;config&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;given?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="462.7" y="198.0" width="109.7" height="59.0" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;_parse_config_file FILE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;per line: trim, section, key=value, unquote&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;_validate_config_value_length, then per-key validator&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;applies values to globals&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="274.5" y="292.0" width="290.0" height="72.0" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;return 1&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="534.2" y="906.0" width="98.5" height="36.0" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;P