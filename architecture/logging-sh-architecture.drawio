0" width="288.0" height="36.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Detect shell family&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;_LOGGER_SHELL_FAMILY = bash | zsh | empty&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;version variable AND shell-only builtin (shopt / emulate)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="93.0" y="61.0" width="304.0" height="58.0" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;_LOGGER_BASH_HAS_ATTRS (bash ≥ 5.1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;define _is_readonly, _logger_readonly&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="106.5" y="144.0" width="277.0" height="43.0" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;_LOGGER_ESC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;readonly?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="151.1" y="212.0" width="187.8" height="59.0" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Build control-character constants&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;ESC BEL CR TAB NEWLINE BOM, UTF-8 C1 list&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;then make them readonly&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="35.0" y="306.0" width="250.0" height="58.0" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;_LOGGER_STRIP_C0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;readonly?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="122.7" y="389.0" width="242.7" height="59.0" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Build sanitiser constants&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;C0 strip set, bidi characters, sed expressions&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;then make them readonly&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="36.5" y="483.0" width="247.0" height="58.0" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Reset per-source state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[:ascii:] probe, *_into result variables, _LOGGER_BUSY=0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;_LOGGER_TIME_BUILTIN, UTF-8 byte-class caches&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="90.5" y="566.0" width="307.0" height="58.0" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;BASH_LOGGER_VERSION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;readonly?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="97.7" y="649.0" width="292.5" height="59.0" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;First source only&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;unset inherited LOG_LEVEL_* and *_ERROR_REPORTED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;readonly LOG_LEVEL_* (0-7), INIT, FATAL, version&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="0.0" y="743.0" width="296.0" height="58.0" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Reset settings to defaults (every source)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;CONSOLE_LOG, LOG_FILE, LOG_FORMAT, CURRENT_LOG_LEVEL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;USE_UTC, USE_JOURNAL, USE_COLORS, limits, SYSLOG_FACILITY&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="72.5" y="826.0" width="343.0" height="58.0" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;COLOR_RESET&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;readonly?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="149.3" y="909.0" width="189.5" height="59.0" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Scrub and set readonly COLOR_*&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="51.5" y="1003.0" width="227.0" height="29.0" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;CONFIG_MAX_* (once)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;LOGGER_PATH = &amp;#x27;&amp;#x27; unless already locked&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;_LOGGER_DISCOVERY_DONE = false&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="130.0" y="1057.0" width="228.0" height="58.0" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Define all functions&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="170.0" y="1140.0" width="148.0" height="29.0" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;zsh and&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;zmodload zsh/parameter?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="115.2" y="1194.0" width="257.6" height="59.0" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Wrap _log_message body via functions[]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;with the _LOGGER_BUSY re-entrancy guard&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="15.0" y="1288.0" width="276.0" height="43.0" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;SCRIPT_NAME inherited&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;and unsafe?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="100.2" y="1356.0" width="287.5" height="59.0" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Sanitise SCRIPT_NAME&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;(skipped if it is readonly)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="96.0" y="1450.0" width="168.0" height="43.0" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;bash, and run&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;directly?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mx