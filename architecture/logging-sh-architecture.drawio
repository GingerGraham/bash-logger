ometry x="430.0" y="42.5" width="190.0" height="43.0" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;log_to_journal LEVEL MSG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;strict level check, discovery&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;force_journal=true&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c4"><mxGeometry x="642.0" y="35.0" width="186.0" height="58.0" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;zsh and&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;_LOGGER_BUSY=1?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="342.1" y="137.0" width="207.8" height="59.0" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;_run_log_call_isolated&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;run in subshell; copy back one-shot flags&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;as exit-status bits (_exit_with_log_state)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="253.5" y="233.0" width="227.0" height="58.0" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;LEVEL &amp;gt; CURRENT_LOG_LEVEL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;and not force_show?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="269.8" y="328.0" width="352.4" height="59.0" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;return 0 (filtered)&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="337.5" y="424.0" width="173.1" height="36.0" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;_log_message: save the 8 _LOGGER_* result variables&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="533.0" y="427.5" width="356.0" height="29.0" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;_write_log_message&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;journal_written = !skip_journal &amp;amp;&amp;amp; (USE_JOURNAL || force_journal)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="534.5" y="487.0" width="353.0" height="43.0" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;_cap_message_length_into&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;pre-cut to max(8192, 4 × largest limit) to bound work&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="566.0" y="557.0" width="290.0" height="43.0" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;_sanitize_log_message_into&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;1. _replace_line_control_chars: LF CR TAB → space (unless unsafe newlines)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;2. _strip_ansi_codes_into: sed/tr only if _contains_strippable_characters&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;(unless unsafe ANSI)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="512.0" y="627.0" width="398.0" height="72.0" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&