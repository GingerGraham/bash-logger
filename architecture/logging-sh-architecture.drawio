="1" parent="1"><mxGeometry x="744.6" y="962.0" width="222.7" height="59.0" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;_append_to_log_file&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;refuse if now a symlink; on failure warn once and echo to stderr&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="666.5" y="1058.5" width="341.0" height="43.0" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;journal_written?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1029.5" y="1058.0" width="209.0" height="44.0" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;_get_syslog_priority_into LEVEL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;truncate sanitised text to LOG_MAX_JOURNAL_LENGTH&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;_strip_ansi_codes_into&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="977.5" y="1139.0" width="297.0" height="58.0" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;_write_to_journal PRIORITY TAG MSG [forced]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;LOGGER_PATH set, executable and readonly&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;quot;$LOGGER_PATH&amp;quot; -p FACILITY.PRIORITY -t TAG -- MSG&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="971.0" y="1234.0" width="306.0" height="58.0" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;stdout / stderr&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;htm