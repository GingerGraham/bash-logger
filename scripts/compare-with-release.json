{
  "baseline_version": "2.7.0",
  "upgrade_guide": "docs/upgrading-to-3.0.md",
  "baseline_rewrites": [
    {
      "shells": [
        "zsh"
      ],
      "pattern": "(\\[|script_name='|initialized by )unknown",
      "replacement": "\\1script.sh",
      "except_cases": [
        "x:no-init",
        "x:no-init-strict",
        "x:unknown-opt",
        "x:config-missing",
        "x:errexit-in-if"
      ],
      "reason": "zsh now detects the script name, where 2.x showed unknown. The excepted cases log before init_logger succeeds, so both versions show unknown.",
      "guide": "#changes-in-zsh-only"
    },
    {
      "shells": [
        "bash"
      ],
      "cases": [
        "ifs-digit"
      ],
      "outputs": [
        "stderr"
      ],
      "pattern": "^<LIB>: line N: return: : numeric argument required\\n",
      "replacement": "",
      "reason": "With digits in IFS, 2.x split the numeric status of its own return and printed 'return: numeric argument required' errors. 3.0 prints none.",
      "guide": "#changes-in-bash-and-zsh"
    },
    {
      "shells": [
        "zsh"
      ],
      "cases": [
        "glob_subst"
      ],
      "outputs": [
        "stdout",
        "log"
      ],
      "pattern": "(\\[script\\.sh\\] )<HOME>$",
      "replacement": "\\1~",
      "reason": "With setopt glob_subst, 2.x replaced a ~ at the start of a message with the home directory. The rewrite turns the home directory back into ~ on the one line of the workload that logs a lone ~.",
      "guide": "#changes-in-zsh-only"
    }
  ],
  "candidate_rewrites": [
    {
      "shells": [
        "zsh"
      ],
      "cases": [
        "warn_nested_var"
      ],
      "outputs": [
        "stderr"
      ],
      "pattern": "^[A-Za-z_<>][A-Za-z0-9_<>]*:N: scalar parameter _LOGGER_[A-Za-z0-9_]+ set in enclosing scope in function [A-Za-z0-9_]+\\n",
      "replacement": "",
      "reason": "The library keeps intermediate results in _LOGGER_ variables, and setopt warn_nested_var makes zsh warn each time a function sets one. Only these warnings are removed, so a warning about any other variable still fails the comparison.",
      "guide": "#changes-in-zsh-only"
    },
    {
      "shells": [
        "bash"
      ],
      "cases": [
        "ifs-digit"
      ],
      "outputs": [
        "stderr"
      ],
      "pattern": "^<LIB>: line N: \\[: too many arguments\\n",
      "replacement": "",
      "reason": "TEMPORARY. A known bug in 3.0.0: with digits in IFS, an unquoted $((...)) in a [ test is split and prints this error. Remove this entry when the bug is fixed."
    }
  ],
  "baseline_unusable": [
    {
      "shells": [
        "zsh"
      ],
      "case": "no_unset",
      "reason": "2.7.0 cannot be sourced under setopt no_unset: it reads BASH_SOURCE[0], which zsh does not set.",
      "covered_by": "test_posix_set_e_set_u"
    },
    {
      "shells": [
        "zsh"
      ],
      "case": "strict",
      "reason": "2.7.0 cannot be sourced under set -u: it reads BASH_SOURCE[0], which zsh does not set.",
      "covered_by": "test_posix_set_e_set_u"
    }
  ],
  "allowed_differences": [
    {
      "shells": [
        "bash",
        "posix",
        "zsh"
      ],
      "case": "x:echo-option-messages",
      "outputs": [
        "stdout",
        "log"
      ],
      "reason": "Messages -n, -e and -E (and - in zsh) are logged",
      "guide": "#changes-in-bash-and-zsh"
    },
    {
      "shells": [
        "bash",
        "posix",
        "zsh"
      ],
      "case": "x:missing-option-value",
      "outputs": [
        "stdout",
        "stderr",
        "status"
      ],
      "reason": "A missing option value is an error; 2.x looped forever in bash",
      "guide": "#changes-in-bash-and-zsh"
    },
    {
      "shells": [
        "bash",
        "posix",
        "zsh"
      ],
      "case": "x:second-config-no-value",
      "outputs": [
        "stdout",
        "stderr",
        "status"
      ],
      "reason": "A second --config with no value is an error",
      "guide": "#changes-in-bash-and-zsh"
    },
    {
      "shells": [
        "bash",
        "posix",
        "zsh"
      ],
      "case": "x:bad-max",
      "outputs": [
        "stdout",
        "stderr"
      ],
      "reason": "A CLI line limit that is invalid octal or above 1048576 is rejected with a warning and the limit in effect stays, as in a config file; 2.x printed shell errors (bash) or kept the value",
      "guide": "#changes-in-bash-and-zsh"
    },
    {
      "shells": [
        "bash",
        "posix",
        "zsh"
      ],
      "case": "x:direct-var-limit",
      "outputs": [
        "stdout",
        "stderr"
      ],
      "reason": "A line limit that is invalid octal disables truncation; zsh reads a leading 0 as octal",
      "guide": "#changes-in-bash-and-zsh"
    },
    {
      "shells": [
        "bash",
        "posix",
        "zsh"
      ],
      "case": "x:logfile-removed",
      "outputs": [
        "stderr"
      ],
      "reason": "A failed log file write prints one error",
      "guide": "#changes-in-bash-and-zsh"
    },
    {
      "shells": [
        "bash",
        "posix",
        "zsh"
      ],
      "case": "x:logfile-removed-strict",
      "outputs": [
        "stderr"
      ],
      "reason": "A failed log file write prints one error; set -u works in zsh",
      "guide": "#changes-in-bash-and-zsh"
    },
    {
      "shells": [
        "bash",
        "posix",
        "zsh"
      ],
      "case": "x:direct-var-level",
      "outputs": [
        "stdout",
        "stderr"
      ],
      "reason": "Levels must be plain numbers",
      "guide": "#changes-in-bash-and-zsh"
    },
    {
      "shells": [
        "bash",
        "posix"
      ],
      "case": "x:backslash-message-xpg-echo",
      "outputs": [
        "stdout",
        "log"
      ],
      "reason": "shopt -s xpg_echo no longer affects messages",
      "guide": "#changes-in-bash-and-zsh"
    },
    {
      "shells": [
        "bash",
        "posix",
        "zsh"
      ],
      "case": "x:turkish-level-names",
      "outputs": [
        "stdout"
      ],
      "reason": "Level names work in a Turkish locale",
      "guide": "#changes-in-bash-and-zsh"
    },
    {
      "shells": [
        "bash",
        "posix",
        "zsh"
      ],
      "case": "x:replaced-date-command",
      "outputs": [
        "stdout"
      ],
      "reason": "Timestamps do not start date in bash 4.2+ and zsh",
      "guide": "#changes-in-bash-and-zsh"
    },
    {
      "shells": [
        "bash",
        "posix",
        "zsh"
      ],
      "case": "x:control-characters",
      "outputs": [
        "stdout",
        "log"
      ],
      "reason": "Control characters, C1 controls, line separators, bidirectional controls and escape sequences outside the 2.x CSI grammar are removed",
      "guide": "#messages-and-control-characters"
    },
    {
      "shells": [
        "bash",
        "posix",
        "zsh"
      ],
      "case": "x:config-notice-stderr-level",
      "outputs": [
        "stdout",
        "stderr"
      ],
      "reason": "CONFIG notices follow the stderr level",
      "guide": "#config-notices"
    },
    {
      "shells": [
        "bash",
        "posix",
        "zsh"
      ],
      "case": "x:config-notice-write-failure",
      "outputs": [
        "stdout",
        "stderr",
        "status"
      ],
      "reason": "A failed log file write from a set_* function is reported and does not exit under set -e",
      "guide": "#config-notices"
    },
    {
      "shells": [
        "zsh"
      ],
      "case": "x:backslash-message",
      "outputs": [
        "stdout",
        "log"
      ],
      "reason": "Backslash sequences in messages are logged as written",
      "guide": "#changes-in-zsh-only"
    },
    {
      "shells": [
        "zsh"
      ],
      "case": "x:backslash-message-xpg-echo",
      "outputs": [
        "stdout",
        "log"
      ],
      "reason": "Backslash sequences in messages are logged as written",
      "guide": "#changes-in-zsh-only"
    },
    {
      "shells": [
        "zsh"
      ],
      "case": "x:no-init-strict",
      "outputs": [
        "stderr"
      ],
      "reason": "set -u works",
      "guide": "#changes-in-zsh-only"
    },
    {
      "shells": [
        "zsh"
      ],
      "case": "x:no-args-u",
      "outputs": [
        "stderr"
      ],
      "reason": "set -u works",
      "guide": "#changes-in-zsh-only"
    },
    {
      "shells": [
        "zsh"
      ],
      "case": "x:source-in-function",
      "outputs": [
        "stdout",
        "stderr"
      ],
      "reason": "Sourcing from inside a function keeps the constants global",
      "guide": "#changes-in-zsh-only"
    },
    {
      "shells": [
        "zsh"
      ],
      "case": "x:preset-readonly",
      "outputs": [
        "stderr"
      ],
      "reason": "The read-only error for a preset constant names _logger_readonly as its location",
      "guide": "#internal-names"
    }
  ]
}
